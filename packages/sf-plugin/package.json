{
  "name": "@apx/sf-plugin",
  "version": "0.2.3",
  "description": "Axtik: offline local Apex checks and experimental tests for Salesforce CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamCousinsGB/axtik.git",
    "directory": "packages/sf-plugin"
  },
  "homepage": "https://github.com/SamCousinsGB/axtik#readme",
  "bugs": "https://github.com/SamCousinsGB/axtik/issues",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "bin",
    "README.md",
    "LICENSE",
    "oclif.manifest.json"
  ],
  "oclif": {
    "bin": "sf",
    "commands": "./lib/commands",
    "topicSeparator": " ",
    "topics": {
      "apx": {
        "description": "Check and evaluate Apex locally with explicit preview boundaries."
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@apx/runner": "0.2.3",
    "@salesforce/sf-plugins-core": "13.0.8",
    "@oclif/core": "5.1.10"
  },
  "bundleDependencies": [
    "@apx/runner",
    "@salesforce/sf-plugins-core",
    "@oclif/core"
  ],
  "devDependencies": {
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  }
}
